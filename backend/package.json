{
  "name": "dsa-backend",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test tests/readinessEngine.test.js",
    "build": "echo Backend build ready",
    "dev": "node --watch server.js",
    "bench": "node benchmarks/autocannon-benchmark.js",
    "bench:autocannon": "npx autocannon -c 20 -d 10 http://localhost:5000/api/health",
    "bench:artillery": "npx artillery run benchmarks/artillery-config.yml",
    "bench:clinic:doctor": "cmd /c \"set PORT=5050&& npx clinic doctor --autocannon [ -c 20 -d 10 /api/health ] -- node server.js\"",
    "bench:clinic:flame": "cmd /c \"set PORT=5050&& npx clinic flame --autocannon [ -c 20 -d 10 /api/health ] -- node server.js\""
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "mongoose": "^9.11.4"
  },
  "devDependencies": {
    "autocannon": "^8.0.0"
  }
}
